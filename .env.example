# Host directory containing data/, datasets and the existing SQLite database.
PROTOLABEL_HOST_WORKSPACE=/absolute/path/to/workspace
PROTOLABEL_AUTH_USERNAME=protolabel
PROTOLABEL_AUTH_PASSWORD=replace-with-a-long-random-password
PROTOLABEL_UID=1000
PROTOLABEL_GID=1000
PROTOLABEL_JOB_WORKERS=2
PROTOLABEL_MAX_UPLOAD_BYTES=2147483648
