FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libgomp1 curl && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip \
    && pip install -r /tmp/requirements.txt \
    && pip uninstall -y opencv-python opencv-contrib-python
RUN pip install --force-reinstall "opencv-python-headless>=4.10" \
    && python -c "import cv2; print(\"OpenCV headless:\", cv2.__version__)"
COPY backend/app /app/app
COPY models /models
EXPOSE 8100
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD curl -fsS http://127.0.0.1:8100/api/health || exit 1
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8100"]
